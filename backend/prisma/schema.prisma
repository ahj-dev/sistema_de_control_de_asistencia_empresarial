generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  EMPLEADO
  JEFE_DEPARTAMENTO
  RRHH
  ADMINISTRADOR
}

enum EstadoEmpleado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  VACACIONES
}

// ─────────────────────────────────────────────
// ENUMS NUEVOS
// ─────────────────────────────────────────────

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
  JUSTIFICADO
  DIA_FESTIVO
  FIN_DE_SEMANA
}

enum TipoJustificacion {
  ENFERMEDAD
  CITA_MEDICA
  CALAMIDAD_DOMESTICA
  PERMISO_PERSONAL
  CAPACITACION
  COMISION
  OTRO
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoHoraExtra {
  DIURNA
  NOCTURNA
  DOMINICAL_DIURNA
  DOMINICAL_NOCTURNA
}

model Departamento {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  empleados Empleado[] @relation("EmpleadoDepartamento")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departamentos")
}

// Datos personales del empleado
model Empleado {
  id              String         @id @default(uuid())
  nombres         String
  apellidos       String
  cedula          String         @unique
  telefono        String?
  fechaNacimiento DateTime?      @map("fecha_nacimiento") @db.Date
  fechaIngreso    DateTime       @map("fecha_ingreso")    @db.Date
  estado          EstadoEmpleado @default(ACTIVO)

  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation("EmpleadoDepartamento", fields: [departamentoId], references: [id])

//Relacion 
  horarioId String?          @map("horario_id")
  horario   HorarioLaboral?  @relation(fields: [horarioId], references: [id])

  registrosAsistencia RegistroAsistencia[]

  // Relación inversa con Usuario, sirve para traer los datos de acceso (email, rol) partiendo desde los datos del empleado
  usuario Usuario?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

// Se crea un indice en la base de datos para que buscar empleados por departamento sea rapido
  @@index([departamentoId])
// En el codigo se llama Empleado pero en la tabla fisica de la bd se llama empleados
  @@map("empleados")

// Credenciales de acceso
}
model Usuario {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  rol          Rol     @default(EMPLEADO)
  activo       Boolean @default(true)

  // Relación opcional con Empleado
  // Basicamente un Admin de TI puede tener usuario sin ser empleado
  empleadoId String?   @unique @map("empleado_id")
  empleado   Empleado? @relation(fields: [empleadoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// TABLA: HorarioLaboral
// Define el turno de trabajo de un empleado.
// diasLaborables es JSON porque es flexible:
// { "lunes": true, "martes": true, ... }
// ─────────────────────────────────────────────

model HorarioLaboral {
  id             String   @id @default(uuid())
  nombre         String   @unique
  horaEntrada    String   @map("hora_entrada")   
  horaSalida     String   @map("hora_salida")     
  toleranciaMin  Int      @default(10) @map("tolerancia_min")
  diasLaborables Json     @map("dias_laborables")
  activo         Boolean  @default(true)

  empleados Empleado[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("horarios_laborales")
}

// ─────────────────────────────────────────────
// TABLA: DiaFestivo
// recurrente = true → aplica cada año (Navidad)
// recurrente = false → festivo único (puente)
// ─────────────────────────────────────────────

model DiaFestivo {
  id         String   @id @default(uuid())
  nombre     String
  fecha      DateTime @db.Date
  recurrente Boolean  @default(false)
  paisRegion String   @default("CO") @map("pais_region")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fecha, paisRegion])
  @@map("dias_festivos")
}

// ─────────────────────────────────────────────
// TABLA: RegistroAsistencia
// Una fila por día por empleado.
// El constraint UNIQUE (empleadoId + fecha)
// garantiza que no haya duplicados.
// ─────────────────────────────────────────────

model RegistroAsistencia {
  id              String           @id @default(uuid())
  empleadoId      String           @map("empleado_id")
  empleado        Empleado         @relation(fields: [empleadoId], references: [id])

  fecha           DateTime         @db.Date
  horaEntrada     DateTime?        @map("hora_entrada")
  horaSalida      DateTime?        @map("hora_salida")

  minutosTarde    Int              @default(0) @map("minutos_tarde")
  horasTrabajadas Decimal?         @map("horas_trabajadas") @db.Decimal(5, 2)

  estado          EstadoAsistencia @default(PRESENTE)
  observacion     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([empleadoId, fecha])
  @@index([fecha])
  @@index([empleadoId, fecha])
  @@map("registros_asistencia")
}